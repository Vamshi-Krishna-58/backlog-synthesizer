.env
venv/
.venv/
venv3*/
__pycache__/
*.pyc
.pytest_cache/
outputs/*.json
outputs/*.md
!outputs/.gitkeep
.DS_Store
.vscode/
.idea/

# Claude Code local tooling config (not part of the project)
.claude/

# Local auth fallback config — holds a bcrypt hash + cookie key; keep only the .example
config/auth.yaml

# local embedding/vector cache
.cache/

# Word lock files
~$*

# Terraform — state files contain secrets, never commit
infra/terraform/.terraform/
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/terraform.tfstate.*.backup
infra/terraform/.terraform.lock.hcl
# terraform.tfvars contains real API keys — use terraform.tfvars.example as template
infra/terraform/terraform.tfvars
infra/terraform/tfplan

# SQLite audit log chain (runtime artifact, not source)
logs/audit_chain.db

# Auth credential file — contains bcrypt password hashes; use config/auth.yaml.example as template
config/auth.yaml
